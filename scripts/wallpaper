#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Full-bleed wallpaper layer. No artificial top/bottom black frame.
set -Eeuo pipefail

STATE_DIR="$HOME/.config/wallpaper-state"
STATE_FILE="$STATE_DIR/current"
INDEX_FILE="$HOME/.cache/xlfr4n/wallpapers.index"
INDEX_TTL_MINUTES=360
DEFAULT_WALLPAPER="${XLFR4N_DEFAULT_WALLPAPER:-/usr/share/backgrounds/kali/kali-hack-16x9.jpg}"

mkdir -p "$STATE_DIR" "$(dirname "$INDEX_FILE")"

collect() {
  local root tmp_index

  if [ "${XLFR4N_WALLPAPER_REINDEX:-0}" != "1" ] &&
     [ -s "$INDEX_FILE" ] &&
     find "$INDEX_FILE" -mmin "-$INDEX_TTL_MINUTES" -print -quit 2>/dev/null |
       grep -Fqx "$INDEX_FILE"; then
    cat "$INDEX_FILE"
    return 0
  fi

  tmp_index="$INDEX_FILE.tmp.$$"

  for root in \
    "$HOME/.local/share/backgrounds" \
    "$HOME/Pictures/Wallpapers" \
    "/usr/share/backgrounds/kali" \
    "/usr/share/backgrounds" \
    "/usr/share/wallpapers"; do
    [ -d "$root" ] || continue
    find "$root" -type f \( \
      -iname '*.jpg' -o \
      -iname '*.jpeg' -o \
      -iname '*.png' -o \
      -iname '*.webp' \
    \) -print
  done |
    sort -u > "$tmp_index"

  mv -f "$tmp_index" "$INDEX_FILE"
  cat "$INDEX_FILE"
}

mapfile -t wallpapers < <(
  collect |
    while IFS= read -r image; do
      [ -f "$image" ] && printf '%s\n' "$image"
    done
)

if [ "${#wallpapers[@]}" -eq 0 ]; then
  command -v xsetroot >/dev/null 2>&1 && xsetroot -solid '#101216'
  echo "No wallpapers found." >&2
  exit 0
fi

current="$(cat "$STATE_FILE" 2>/dev/null || true)"

set_wallpaper() {
  local image="$1"

  [ -f "$image" ] || {
    echo "Wallpaper not found: $image" >&2
    return 1
  }

  feh --no-fehbg --bg-fill "$image"
  printf '%s\n' "$image" > "$STATE_FILE"

  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u low -t 1000 "xLFr4n // WALLPAPER" "$(basename "$image")" \
      >/dev/null 2>&1 || true
  fi

  printf 'Wallpaper: %s\n' "$image"
}

case "${1:-}" in
  --default)
    set_wallpaper "$DEFAULT_WALLPAPER"
    ;;
  --random|"")
    index=$(( $(od -An -N4 -tu4 /dev/urandom) % ${#wallpapers[@]} ))
    if [ "${#wallpapers[@]}" -gt 1 ] &&
       [ "${wallpapers[$index]}" = "$current" ]; then
      index=$(( (index + 1) % ${#wallpapers[@]} ))
    fi
    set_wallpaper "${wallpapers[$index]}"
    ;;
  --next)
    next=0
    for i in "${!wallpapers[@]}"; do
      if [ "${wallpapers[$i]}" = "$current" ]; then
        next=$(( (i + 1) % ${#wallpapers[@]} ))
        break
      fi
    done
    set_wallpaper "${wallpapers[$next]}"
    ;;
  --current)
    if [ -n "$current" ] && [ -f "$current" ]; then
      set_wallpaper "$current"
    else
      set_wallpaper "$DEFAULT_WALLPAPER"
    fi
    ;;
  --set)
    [ -n "${2:-}" ] || {
      echo "Usage: wallpaper --set /path/to/image" >&2
      exit 2
    }
    set_wallpaper "$2"
    ;;
  *)
    echo "Usage: wallpaper [--default|--random|--next|--current|--set FILE]" >&2
    exit 2
    ;;
esac
