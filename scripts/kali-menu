#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Command palette for the whole workspace. Actions remain real commands.
set -Eeuo pipefail

command -v rofi-xlfr4n >/dev/null 2>&1 || {
  echo "rofi-xlfr4n is not installed." >&2
  exit 127
}

entries=$(cat <<'EOF'
TERMINAL      Ghostty + fresh tmux
APPLICATIONS  Launch applications
WINDOWS       Mission Control
BRAVE         Open Brave
DOCK          Toggle application dock
DOCK-REPAIR   Rebuild dock launchers
DESKTOP       Apply desktop presentation
TARGET        Set or clear engagement target
NETWORK       Network Manager
LAB           Open Kali Lab
LABSTATUS     Engagement status
LABTOOLS      Red-team tool profiles
THEME         Change workspace theme
WALLPAPER     Change wallpaper
MONITOR       Refresh displays
SCREEN        Screenshot tools
DOCTOR        Run diagnostics
SYSTEM        System snapshot
VIRT          Virtualization tools
LOCK          Lock session
POWER         Power menu
EXIT          Close menu
EOF
)

if command -v firefox-esr >/dev/null 2>&1 || command -v firefox >/dev/null 2>&1; then
  entries+="
FIREFOX       Open Firefox"
fi
if command -v wireshark >/dev/null 2>&1; then
  entries+="
WIRESHARK     Capture and analyse traffic"
fi
if command -v burpsuite >/dev/null 2>&1; then
  entries+="
BURP          Open Burp Suite"
fi
if command -v zaproxy >/dev/null 2>&1; then
  entries+="
ZAPROXY       Open OWASP ZAP"
fi

choice="$(printf '%s\n' "$entries" | rofi-xlfr4n -dmenu -i -matching fuzzy -p '⚡ xLFr4n' || true)"

case "$choice" in
  TERMINAL*) dock-launch terminal ;;
  APPLICATIONS*) rofi-xlfr4n -show drun -show-icons -p 'Apps' ;;
  WINDOWS*) mission-control ;;
  BRAVE*) dock-launch brave ;;
  FIREFOX*) dock-launch firefox ;;
  WIRESHARK*) dock-launch wireshark ;;
  BURP*) dock-launch burp ;;
  ZAPROXY*) dock-launch zaproxy ;;
  DOCK-REPAIR*) dock --restart ;;
  DOCK*) dock --toggle ;;
  DESKTOP*) desktop-style --apply ;;
  TARGET*) settarget ;;
  NETWORK*) dock-launch network ;;
  LABSTATUS*) xlfr4n-terminal --title Kali-Engagement -- lab status ;;
  LABTOOLS*) xlfr4n-terminal --title Kali-RedTeam-Tools -- lab tools status ;;
  LAB*) dock-launch lab ;;
  THEME*) theme-switch ;;
  WALLPAPER*) wallpaper --random ;;
  MONITOR*) monitor-refresh ;;
  SCREEN*) screenshot-menu ;;
  DOCTOR*) xlfr4n-terminal --title Kali-Doctor -- doctor.sh ;;
  SYSTEM*) xlfr4n-terminal --title xLFr4n-System -- xlfr4n-banner --static ;;
  VIRT*) xlfr4n-terminal --title Virtualization-Tools -- vmware-tools ;;
  LOCK*) lock-screen ;;
  POWER*) power-menu ;;
  EXIT*|"") exit 0 ;;
esac
