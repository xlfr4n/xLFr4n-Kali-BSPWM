#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Floating application dock. One backend only: Tint2 first, Plank fallback, Polybar fallback.
set -Eeuo pipefail

CONFIG="$HOME/.config/plank"
DOCK="$CONFIG/dock1"
LAUNCHERS="$DOCK/launchers"
SOURCE_THEME="$CONFIG/xLFr4n/dock.theme"
TINT2_CONFIG="$HOME/.config/tint2/tint2rc"
THEME_DIR="$HOME/.local/share/plank/themes/xLFr4n"
LOG="$HOME/.cache/xlfr4n-dock.log"
mkdir -p "$LAUNCHERS" "$THEME_DIR" "$(dirname "$LOG")"
log(){ printf '[dock] %s\n' "$*" >> "$LOG"; }

apply_settings(){
  command -v gsettings >/dev/null 2>&1 || return 0
  local schema="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
  gsettings set "$schema" theme "'xLFr4n'" 2>/dev/null || true
  gsettings set "$schema" position "'bottom'" 2>/dev/null || true
  gsettings set "$schema" hide-mode "'intelligent'" 2>/dev/null || true
  gsettings set "$schema" icon-size 48 2>/dev/null || true
  gsettings set "$schema" zoom-enabled true 2>/dev/null || true
  gsettings set "$schema" zoom-percent 140 2>/dev/null || true
  gsettings set "$schema" items-alignment "'center'" 2>/dev/null || true
  gsettings set "$schema" alignment "'center'" 2>/dev/null || true
}

install_theme(){
  [ -s "$SOURCE_THEME" ] || return 0
  install -Dm644 "$SOURCE_THEME" "$THEME_DIR/dock.theme"
}

install_launcher(){
  local id="$1" name="$2" icon="$3" wmclass="${4:-}"
  local desktop="$HOME/.local/share/applications/xLFr4n-${id}.desktop"
  mkdir -p "$(dirname "$desktop")"
  cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=$name
Comment=xLFr4n workspace launcher
Exec=/usr/local/bin/xLFr4n-dock-launch $id
Icon=$icon
Terminal=false
NoDisplay=true
StartupNotify=true
EOF
  [ -n "$wmclass" ] && printf 'StartupWMClass=%s\n' "$wmclass" >> "$desktop"
  printf '[PlankDockItemPreferences]\nLauncher=file://%s\n' "$desktop" > "$LAUNCHERS/$id.dockitem"
}

build_launchers(){
  rm -f "$LAUNCHERS"/*.dockitem 2>/dev/null || true
  command -v brave-browser >/dev/null 2>&1 && install_launcher brave "Brave Browser" "brave-browser" "brave-browser"
  command -v xlfr4n-terminal >/dev/null 2>&1 && install_launcher terminal "xLFr4n — Terminal" "utilities-terminal"
  command -v thunar >/dev/null 2>&1 && install_launcher files "Files" "system-file-manager" "Thunar"
  command -v code >/dev/null 2>&1 && install_launcher code "Visual Studio Code" "code" "Code"
  command -v burpsuite >/dev/null 2>&1 && install_launcher burp "Burp Suite" "burpsuite" "BurpSuite"
  install_launcher editor "Neovim" "text-editor"
  install_launcher kali-menu "⚡ xLFr4n Menu" "xlfr4n-menu"
  install_launcher target "Target Console" "xlfr4n-target" "kali-target"
  install_launcher lab "Kali Lab" "xlfr4n-lab" "kali-lab"
  command -v btop >/dev/null 2>&1 && install_launcher btop "System Monitor" "utilities-system-monitor"
  command -v lxappearance >/dev/null 2>&1 && install_launcher settings "Appearance" "preferences-desktop-theme" "Lxappearance"
  command -v nm-connection-editor >/dev/null 2>&1 && install_launcher network "Network" "network-wired" "Nm-connection-editor"
  command -v flameshot >/dev/null 2>&1 && install_launcher screenshot "Screenshot" "camera-photo"
  command -v wireshark >/dev/null 2>&1 && install_launcher wireshark "Wireshark" "wireshark" "wireshark"
  if command -v firefox-esr >/dev/null 2>&1 || command -v firefox >/dev/null 2>&1; then
    install_launcher firefox "Firefox" "firefox" "firefox"
  fi
  command -v zaproxy >/dev/null 2>&1 && install_launcher zaproxy "OWASP ZAP" "zaproxy" "ZAP"
}

start_tint2(){
  command -v tint2 >/dev/null 2>&1 || return 1
  [ -r "$TINT2_CONFIG" ] || return 1
  pkill -u "$UID" -x tint2 2>/dev/null || true
  nohup tint2 -c "$TINT2_CONFIG" >> "$LOG" 2>&1 &
  disown || true
}

start_plank(){
  command -v plank >/dev/null 2>&1 || return 1
  pkill -u "$UID" -x plank 2>/dev/null || true
  nohup plank >> "$LOG" 2>&1 &
  disown || true
  sleep 0.5
  apply_settings
}

start_polybar(){
  command -v polybar >/dev/null 2>&1 || { log "Polybar is not installed."; return 1; }
  pkill -u "$UID" -f '[p]olybar dock' 2>/dev/null || true
  nohup polybar dock -c "$HOME/.config/polybar/config.ini" >> "$LOG" 2>&1 &
  disown || true
}

start_backend(){
  stop_backend
  if command -v tint2 >/dev/null 2>&1 && [ -r "$TINT2_CONFIG" ]; then
    start_tint2
  elif command -v plank >/dev/null 2>&1; then
    start_plank
  else
    start_polybar
  fi
}

stop_backend(){
  pkill -u "$UID" -x tint2 2>/dev/null || true
  pkill -u "$UID" -x plank 2>/dev/null || true
  pkill -f '[p]olybar dock' 2>/dev/null || true
}

status_backend(){
  if pgrep -u "$UID" -x tint2 >/dev/null 2>&1; then
    echo "Tint2 dock: running"
    return 0
  fi
  if pgrep -u "$UID" -x plank >/dev/null 2>&1; then
    echo "Plank dock: running"
    return 0
  fi
  if pgrep -u "$UID" -af '[p]olybar dock' >/dev/null 2>&1; then
    echo "Polybar dock: running"
    return 0
  fi
  echo "Floating dock: stopped"
  return 1
}

case "${1:---start}" in
  --start|"")
    install_theme
    build_launchers
    start_backend
    ;;
  --restart)
    install_theme
    build_launchers
    stop_backend
    start_backend
    ;;
  --stop)
    stop_backend
    ;;
  --toggle)
    if pgrep -u "$UID" -x tint2 >/dev/null 2>&1 || pgrep -u "$UID" -x plank >/dev/null 2>&1 || pgrep -u "$UID" -af '[p]olybar dock' >/dev/null 2>&1; then
      stop_backend
    else
      install_theme
      build_launchers
      start_backend
    fi
    ;;
  --status)
    status_backend
    ;;
  --backend)
    if command -v tint2 >/dev/null 2>&1 && [ -r "$TINT2_CONFIG" ]; then
      echo "tint2"
    elif command -v plank >/dev/null 2>&1; then
      echo "plank"
    else
      echo "polybar-fallback"
    fi
    ;;
  *)
    echo "Usage: dock [--start|--restart|--stop|--toggle|--status|--backend]" >&2
    exit 2
    ;;
esac
