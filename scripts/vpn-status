#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Compact, truthful VPN indicator: hide the module when no tunnel is active.
set -u

theme="$(cat "$HOME/.config/theme-state/current" 2>/dev/null || printf 'cyber-red')"
case "$theme" in
  htb-green) good='#5ee881' ;;
  nord) good='#a3be8c' ;;
  purple) good='#50fa7b' ;;
  *) good='#5ee881' ;;
esac

show_tunnel() {
  local iface="$1" label ip4 state
  state="$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || printf 'unknown')"
  [ "$state" = "up" ] || return 1

  ip4="$(ip -4 addr show dev "$iface" 2>/dev/null | awk '/inet / {sub(/\/.*/, "", $2); print $2; exit}')"
  [ -n "$ip4" ] || return 1

  case "$iface" in
    tun*)
      pgrep -af '[o]penvpn' >/dev/null 2>&1 || return 1
      label="VPN"
      ;;
    wg*)
      command -v wg >/dev/null 2>&1 || return 1
      wg show "$iface" >/dev/null 2>&1 || return 1
      label="WG"
      ;;
    *) return 1 ;;
  esac

  printf '%%{F%s}%%{T2}%%{T-} %s · %s%%{F-}\n' "$good" "$label" "$ip4"
}

for path in /sys/class/net/tun* /sys/class/net/wg*; do
  [ -e "$path" ] || continue
  iface="${path##*/}"
  show_tunnel "$iface" && exit 0
done

exit 0
