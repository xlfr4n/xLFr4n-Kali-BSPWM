#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026

set -Eeuo pipefail

command -v flameshot >/dev/null 2>&1 || {
  echo "Flameshot is not installed." >&2
  exit 1
}

mkdir -p "$HOME/Pictures/Screenshots"

choice="$(printf '%s\n' \
  'REGION      Select region' \
  'FULLSCREEN  Capture full screen' |
  rofi-xlfr4n -dmenu -p 'Screenshot' || true)"

case "$choice" in
  REGION*) xlfr4n-launch "Screenshot" -- flameshot gui ;;
  FULLSCREEN*) xlfr4n-launch "Screenshot" -- flameshot full -p "$HOME/Pictures/Screenshots" ;;
esac
