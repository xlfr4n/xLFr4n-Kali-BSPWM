#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Static identity helper. Kept as a compatibility entrypoint; no animation.
set -u

theme="$(cat "\${HOME}/.config/theme-state/current" 2>/dev/null || printf 'cyber-red')"
case "$theme" in
  htb-green) accent='#9fef00' ;;
  nord) accent='#88c0d0' ;;
  purple) accent='#bd93f9' ;;
  *) accent='#ff3344' ;;
esac

printf '%%{F%s}⚡ xLFr4n%%{F-}\\n' "$accent"
