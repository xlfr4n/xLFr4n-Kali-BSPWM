# ⚡ xLFr4n // Floating application dock
# Tint2 launcher-only layer. Real .desktop icons, tooltips and clean floating geometry.

#-------------------------------------
# Backgrounds
#-------------------------------------
rounded = 18
border_width = 0
border_sides = TBLR
background_color = #00000000 0
border_color = #00000000 0

rounded = 12
border_width = 0
border_sides = TBLR
background_color = #161b22 96
border_color = #00000000 0

#-------------------------------------
# Panel
#-------------------------------------
panel_monitor = primary
panel_position = bottom center horizontal
panel_items = L
panel_size = 900 72
panel_margin = 0 0
panel_padding = 0 0 0
panel_background_id = 0
panel_layer = top
panel_dock = 0
wm_menu = 0
strut_policy = follow_size
panel_window_name = xLFr4n Dock
mouse_effects = 1
font_shadow = 0
mouse_hover_icon_asb = 100 0 18
mouse_pressed_icon_asb = 100 0 -10

#-------------------------------------
# Launcher
#-------------------------------------
launcher_padding = 5 0 5
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 52
launcher_icon_asb = 100 0 0
launcher_icon_theme = Papirus-Dark
launcher_icon_theme_override = 1
launcher_tooltip = 1
startup_notifications = 0

launcher_item_app = ~/.local/share/applications/xLFr4n-kali-menu.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-brave.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-terminal.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-files.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-editor.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-code.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-burp.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-lab.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-target.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-btop.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-settings.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-network.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-screenshot.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-wireshark.desktop
launcher_item_app = ~/.local/share/applications/xLFr4n-firefox.desktop

#-------------------------------------
# Tooltips
#-------------------------------------
tooltip = 1
tooltip_padding = 7 8
tooltip_show_timeout = 0.15
tooltip_hide_timeout = 0.05
tooltip_background_id = 2
tooltip_font_color = #ffffff 100
tooltip_font = Noto Sans normal 9

#-------------------------------------
# Mouse
#-------------------------------------
mouse_left = none
mouse_middle = none
mouse_right = toggle
mouse_scroll_up = none
mouse_scroll_down = none

#-------------------------------------
# Everything else intentionally disabled
#-------------------------------------
taskbar_mode = single_desktop
systray = 0
battery = 0
