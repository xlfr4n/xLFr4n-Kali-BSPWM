/* ⚡ xLFr4n // Kali command palette */
* {
  bg: #0b0d10;
  bg-alt: #141920;
  fg: #f0f3f7;
  muted: #7d8590;
  accent: #ff3344;
  background-color: @bg;
  text-color: @fg;
  font: "JetBrains Mono 10";
}

window {
  width: 47%;
  location: center;
  anchor: center;
  background-color: @bg;
  border: 0px;
  border-color: transparent;
  border-radius: 18px;
  padding: 18px;
}

mainbox {
  padding: 6px;
}

inputbar {
  padding: 10px 12px;
  background-color: @bg-alt;
  border: 0px;
  border-color: transparent;
  border-radius: 10px;
}

prompt {
  text-color: @accent;
  padding: 0px 10px 0px 0px;
}

entry {
  text-color: @fg;
  placeholder: "Search command…";
  placeholder-color: @muted;
}

listview {
  lines: 16;
  columns: 1;
  fixed-height: false;
  spacing: 4px;
  padding: 10px 0px 0px 0px;
}

element {
  padding: 9px 11px;
  border-radius: 8px;
  background-color: transparent;
}

element selected {
  background-color: #1b2028;
}

element-text {
  text-color: @fg;
}

element-text selected {
  text-color: @accent;
}

element-icon {
  size: 0em;
}
