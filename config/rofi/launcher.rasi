/* ⚡ xlfr4n // Kali BSPWM 2026 */

* {
  bg: #0b0d10;
  bg-alt: #161b22;
  fg: #ffffff;
  muted: #8b949e;
  accent: #ff3344;
  dark-accent: #ffffff;
  font: "JetBrains Mono 10";
  border: #22262d;
  background-color: @bg;
  text-color: @fg;
}

configuration {
  show-icons: true;
  icon-theme: "Papirus-Dark";
  drun-display-format: "{name}";
}

window {
  width: 52%;
  location: center;
  anchor: center;
  background-color: @bg;
  border: 0px;
  border-color: transparent;
  border-radius: 16px;
  padding: 18px;
}

mainbox {
  padding: 6px;
}

inputbar {
  padding: 10px;
  background-color: @bg-alt;
  border: 0px;
  border-color: transparent;
  border-radius: 8px;
}

prompt {
  text-color: @accent;
  padding: 0px 10px 0px 0px;
}

entry {
  text-color: @fg;
  placeholder: "Search xlfr4n...";
  placeholder-color: @muted;
}

listview {
  lines: 14;
  columns: 1;
  fixed-height: false;
  spacing: 6px;
  padding: 8px 0px 0px 0px;
}

element {
  padding: 10px;
  border-radius: 8px;
  background-color: transparent;
}

element-text {
  text-color: @fg;
  font: "JetBrains Mono 10";
}

element selected {
  background-color: @accent;
}

element-text selected {
  text-color: #ffffff;
  font: "JetBrains Mono 10";
}

element-icon {
  size: 1.0em;
  padding: 0px 8px 0px 0px;
}
