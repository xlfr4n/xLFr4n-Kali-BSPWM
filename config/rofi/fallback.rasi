/* ⚡ xLFr4n // Rofi dark emergency theme */
* {
  bg: #0b0d10;
  fg: #ffffff;
  accent: #ff3344;
  muted: #8b949e;
  font: "JetBrains Mono 10";
  background-color: @bg;
  text-color: @fg;
}
window { width: 46%; location: center; anchor: center; background-color: @bg; border: 0px; border-color: transparent; border-radius: 16px; padding: 16px; }
mainbox { padding: 4px; }
inputbar { padding: 10px; background-color: #161b22; border: 0px; border-color: transparent; border-radius: 8px; }
prompt { text-color: @accent; padding: 0px 10px 0px 0px; }
entry { text-color: @fg; placeholder: "Search xLFr4n..."; placeholder-color: @muted; }
listview { lines: 9; spacing: 6px; padding: 8px 0px 0px; }
element { padding: 9px; border-radius: 8px; background-color: transparent; }
element selected { background-color: #1b2028; }
element-text { text-color: @fg; }
element-text selected { text-color: @accent; }
element-icon { size: 1.0em; padding: 0px 8px 0px 0px; }
